# Optional at startup. Leave empty to inspect the console's explicit
# "provider API key 없음" state; set a real key before sending completions.
LUMEN_LOCAL_PROVIDER_API_KEY=
# Generated connection.json advertises loopback + LUMEN_API_PORT by default.
# Set the full OpenAI SDK base URL when clients use a proxy or remote hostname.
LUMEN_LOCAL_PUBLIC_BASE_URL=
LUMEN_API_PORT=8012
LUMEN_CONSOLE_PORT=7010

# Defaults target OpenAI through LiteLLM. Set a compatible base URL/type/model for another provider.
LUMEN_LOCAL_PROVIDER_TYPE=openai
LUMEN_LOCAL_PROVIDER_BASE_URL=
LUMEN_LOCAL_MODEL=gpt-4.1-mini
LUMEN_LOCAL_INPUT_PRICE_PER_MILLION=1
LUMEN_LOCAL_OUTPUT_PRICE_PER_MILLION=3
