# Direct provider keys are optional. Keep them empty to inspect the console's
# "provider API key 없음" state; set the corresponding key before calling a model.
# Never commit real credentials or share an expanded `docker compose config`.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Generated connection.json advertises loopback + LUMEN_API_PORT by default.
# Set the full OpenAI SDK base URL when clients use a proxy or remote hostname.
LUMEN_LOCAL_PUBLIC_BASE_URL=
LUMEN_API_PORT=8012
LUMEN_CONSOLE_PORT=7010

# With a key, bootstrap enables that provider's default text model (OpenAI or
# Gemini); when both keys are set, OpenAI is preferred for the local default.
# Override the preferred model explicitly if needed. For Gemini, use the
# gemini/<model-id> route spelling (e.g. gemini/gemini-2.5-flash) so the
# CHAT_DEFAULT_MODEL for model="lumen" durable chat resolves to the same route.
LUMEN_LOCAL_MODEL=
CHAT_DEFAULT_MODEL=
# Optional custom local route (name/type/base/model); no custom key is needed
# for the official OpenAI/Gemini direct provider registrations above.
LUMEN_LOCAL_PROVIDER_TYPE=openai
LUMEN_LOCAL_PROVIDER_BASE_URL=
# These are development-only OpenAI text ledger rates, not live vendor prices.
# Set verified prices for billing, or register a correctly priced Admin model.
LUMEN_LOCAL_INPUT_PRICE_PER_MILLION=1
LUMEN_LOCAL_OUTPUT_PRICE_PER_MILLION=3

# Media models require an explicit supported model ID, kind and USD unit price.
# Disabled by default. Sample prices below are illustrative, NOT provider rates:
# replace every price with current provider pricing before opting in. A key is
# still required for the chosen provider; no provider secret belongs in JSON.
LUMEN_BOOTSTRAP_MODELS_JSON=[]
# LUMEN_BOOTSTRAP_MODELS_JSON=[{"provider":"openai","model_name":"gpt-image-1","model_kind":"image","media_pricing":{"image_variants":{"1024x1024:high":"0.08"}}},{"provider":"openai","model_name":"tts-1","model_kind":"tts","media_pricing":{"audio_output_per_second":"0.01"}},{"provider":"openai","model_name":"whisper-1","model_kind":"stt","media_pricing":{"audio_input_per_second":"0.01"}},{"provider":"openai","model_name":"gpt-realtime","model_kind":"realtime","media_pricing":{"realtime_input_per_minute":"0.01","realtime_output_per_minute":"0.02"}}]
