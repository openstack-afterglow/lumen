# Lumen registered defaults; copy selected rules to /etc/lumen/policy.yaml.
# Regenerate: oslopolicy-sample-generator --namespace lumen --output-file lumen/policy.yaml.sample
# Native project member or higher manages resources; reader has read-only access.
# Ownership, standard-role ceilings, credential scopes and human system boundaries are not overridable.
"models:read": "is_system_admin:True or role:admin or role:manager or role:member or role:reader"
"usage:read": "is_system_admin:True or role:admin or role:manager or role:member or role:reader"
"compat:completions:write": "is_system_admin:True or role:admin or role:manager or role:member"
"compat:images:write": "is_system_admin:True or role:admin or role:manager or role:member"
"compat:audio:write": "is_system_admin:True or role:admin or role:manager or role:member"
"compat:realtime:write": "is_system_admin:True or role:admin or role:manager or role:member"
"compat:batches:read": "is_system_admin:True or role:admin or role:manager or role:member or role:reader"
"compat:batches:write": "is_system_admin:True or role:admin or role:manager or role:member"
"compat:files:read": "is_system_admin:True or role:admin or role:manager or role:member or role:reader"
"compat:files:write": "is_system_admin:True or role:admin or role:manager or role:member"
"compat:files:delete": "is_system_admin:True or role:admin or role:manager or role:member"
"native:conversations:read": "is_system_admin:True or role:admin or role:manager or role:member or role:reader"
"native:conversations:write": "is_system_admin:True or role:admin or role:manager or role:member"
"native:conversations:delete": "is_system_admin:True or role:admin or role:manager or role:member"
"native:runs:read": "is_system_admin:True or role:admin or role:manager or role:member or role:reader"
"native:runs:write": "is_system_admin:True or role:admin or role:manager or role:member"
"native:images:write": "is_system_admin:True or role:admin or role:manager or role:member"
"native:audio:write": "is_system_admin:True or role:admin or role:manager or role:member"
"native:realtime:write": "is_system_admin:True or role:admin or role:manager or role:member"
"native:assets:read": "is_system_admin:True or role:admin or role:manager or role:member or role:reader"
"native:assets:write": "is_system_admin:True or role:admin or role:manager or role:member"
"native:assets:delete": "is_system_admin:True or role:admin or role:manager or role:member"
"native:batches:read": "is_system_admin:True or role:admin or role:manager or role:member or role:reader"
"native:batches:write": "is_system_admin:True or role:admin or role:manager or role:member"
"native:extensions:read": "is_system_admin:True or role:admin or role:manager or role:member or role:reader"
"native:extensions:write": "is_system_admin:True or role:admin or role:manager or role:member"
"native:extensions:delete": "is_system_admin:True or role:admin or role:manager or role:member"
"native:tools:execute": "is_system_admin:True or role:admin or role:manager or role:member"
"native:memory:read": "is_system_admin:True or role:admin or role:manager or role:member or role:reader"
"native:memory:write": "is_system_admin:True or role:admin or role:manager or role:member"
"native:memory:delete": "is_system_admin:True or role:admin or role:manager or role:member"
"native:agents:use": "is_system_admin:True or role:admin or role:manager or role:member"
"native:agents:read": "is_system_admin:True or role:admin or role:manager or role:member or role:reader"
"native:agents:write": "is_system_admin:True or role:admin or role:manager or role:member"
"native:agents:delete": "is_system_admin:True or role:admin or role:manager or role:member"
"native:mcp:write": "is_system_admin:True or role:admin or role:manager or role:member"
"native:keys:read": "is_system_admin:True or role:admin or role:manager or role:member or role:reader"
"native:keys:write": "is_system_admin:True or role:admin or role:manager or role:member"
"native:keys:delete": "is_system_admin:True or role:admin or role:manager or role:member"
"system:admin": "is_system_admin:True"
