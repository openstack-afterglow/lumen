# 환경변수는 이 TOML 값보다 우선한다. 실제 secret을 저장소에 넣지 않는다.
# LUMEN_CONFIG_FILE로 다른 파일을 지정할 수 있다. 명시된 파일은 누락/빈 TOML 시 실패한다.

[keystone]
keystone_auth_url = "https://keystone.example/v3"
keystone_admin_username = "CHANGE_ME"
keystone_admin_password = "CHANGE_ME"
keystone_admin_project = "admin"
keystone_domain = "Default"
keystone_region_name = "RegionOne"
keystone_interface = "internal"
os_cacert = "/etc/ssl/certs/ca-certificates.crt"
insecure = false
frontend_base_url = "https://afterglow.example"
public_api_base = "https://lumen.example"
cors_origins = "https://afterglow.example"

[database]
database_url = "mysql+aiomysql://lumen:CHANGE_ME@mariadb:3306/lumen"
database_pool_size = 20
database_max_overflow = 10
database_connect_timeout = 10
database_pool_timeout = 30
database_unhealthy_seconds = 15
database_auto_create_tables = false

[cache]
redis_url = "redis://redis:6379/8"
redis_db_index = 8

[lumen]
# 정확히 64개의 hex 문자. lumen_encryption_key가 필요하다.
lumen_encryption_key = "CHANGE_TO_64_HEX_CHARACTERS"
service_chat_enabled = true
worker_concurrency = 4
# Fixed workers keep existing text/media service; run batch on a separate process.
worker_workload_classes = ["online_text", "online_media"]
worker_heartbeat_seconds = 5
worker_drain_seconds = 300
# Admission rejects new HTTP/SSE requests with 429 and WS handshakes with 503;
# draining refuses new traffic without terminating established streams/sessions.
api_max_active_requests = 256
api_max_sse_connections = 256
api_max_websocket_connections = 64
api_max_body_bytes = 220200960
batch_enabled = false
batch_dispatch_window = 8
batch_project_dispatch_window = 32
batch_native_max_items = 1000
batch_native_max_bytes = 10485760
batch_jsonl_max_rows = 50000
batch_jsonl_max_bytes = 200000000
batch_jsonl_max_line_bytes = 4194304
batch_validation_chunk_rows = 100
batch_validation_chunk_bytes = 1048576
batch_upload_slots = 4
batch_result_ttl_days = 7
batch_input_ttl_days = 30
batch_cancel_grace_seconds = 600

# Opt-in only after provisioning distinct trusted/sandbox projects, dedicated internal
# CA and guest images. Override the whole mapping with RUNTIME_CONFIG JSON if needed.
# Missing enabled-pool prerequisites are configuration errors, not fallback values.
[lumen.runtime_config]
enabled = false
deployment_id = "lumen"
controller_url = ""
listen_host = "127.0.0.1"
listen_port = 8013
reconcile_interval_seconds = 5
pool_lease_seconds = 30
max_parallel_cloud_operations = 4
managed_networks = []
cloud_profiles = []
pools = []
guest_profiles = []
workload_pools = {}
# Supply measured deployment budgets, including fixed/controller/maintenance
# connections and each pool's reserved replacement surge. Never guess cloud quotas.
# db_connection_budget = OPERATOR_DB_BUDGET
# pg_connection_budget = OPERATOR_PG_BUDGET
# fixed_db_connection_reserve = OPERATOR_FIXED_DB_RESERVE
# controller_db_connection_reserve = OPERATOR_CONTROLLER_DB_RESERVE
# fixed_pg_connection_reserve = OPERATOR_FIXED_PG_RESERVE
# controller_pg_connection_reserve = OPERATOR_CONTROLLER_PG_RESERVE
# tls = { ca_file = "/etc/lumen/controller/ca.pem", ca_key_file = "/etc/lumen/controller/ca.key", cert_file = "/etc/lumen/controller/controller.pem", key_file = "/etc/lumen/controller/controller.key", operator_client_cert_file = "/etc/lumen/controller/worker.pem", operator_client_key_file = "/etc/lumen/controller/worker.key" }
# dispatch_key = { file = "/etc/lumen/controller/dispatch.key" }

# Managed topology templates remain commented so the disabled example loads.
# Before using array tables, remove pools=[], cloud_profiles=[], guest_profiles=[]
# and workload_pools={} above. Supply real Nova/Octavia IDs, OCI digest, image hash,
# matching trusted cloud/guest profiles and measured per-pool DB/PG reservations.
# [lumen.runtime_config.workload_pools]
# online_text = "text"
# online_media = "media"
# batch = "batch"
#
# [[lumen.runtime_config.guest_profiles]]
# id = "api-service"
# role = "api"
# config_file = "/etc/lumen/controller/guest-api.conf" # controller-only, root-owned 0600
# config_sha256 = "REPLACE_WITH_CONFIG_SHA256"
# config_keys = ["service_chat_enabled", "api_max_active_requests", "api_max_sse_connections", "api_max_websocket_connections"]
# secret_env_names = ["DATABASE_URL", "REDIS_URL", "LUMEN_ENCRYPTION_KEY"]
# secrets = { DATABASE_URL = { file = "/etc/lumen/controller/database-url" }, REDIS_URL = { file = "/etc/lumen/controller/redis-url" }, LUMEN_ENCRYPTION_KEY = { file = "/etc/lumen/controller/encryption-key" } }
# image = "REPLACE_WITH_RELEASE_OCI_DIGEST_REF"
# plugin_digest = "REPLACE_WITH_PLUGIN_SHA256"
# schema_version = OPERATOR_SCHEMA_VERSION # match inspected release artifact; not migration number
# protocol_version = 2
# Worker profiles use role="worker", their own allowlists and matching release image.
# Profiles are fetched after bootstrap by mTLS GET /v1/runtime/guest-config;
# config/secret bytes, cloud credentials and controller keys never enter user-data.
#
# [[lumen.runtime_config.pools]]
# name = "api"
# role = "api"
# backend = "nova"
# enabled = true
# cloud_profile_id = "OPERATOR_TRUSTED_PROFILE"
# guest_profile_id = "api-service"
# image = "REPLACE_WITH_RELEASE_OCI_DIGEST_REF"
# architecture = "x86_64" # use only an architecture proven on the target Nova compute
# network_id = "OPERATOR_NETWORK_ID"
# security_group_ids = ["OPERATOR_SECURITY_GROUP_ID"]
# min_replicas = 2
# max_replicas = OPERATOR_API_MAX
# max_surge = 1
# boot_timeout_seconds = 600
# idle_seconds = 300
# drain_seconds = 300
# max_lifetime_seconds = 86400
# db_connections_per_process = OPERATOR_API_DB_CONNECTIONS
# pg_connections_per_process = OPERATOR_API_PG_CONNECTIONS
# db_connection_budget = OPERATOR_API_DB_RESERVATION
# pg_connection_budget = OPERATOR_API_PG_RESERVATION
# profile = { backend = "nova", flavor_id = "OPERATOR_API_FLAVOR_ID", guest_image_id = "OPERATOR_API_GLANCE_ID", guest_image_hash = "REPLACE_WITH_GLANCE_SHA256" }
# ingress = { ingress_pool_id = "OPERATOR_OCTAVIA_POOL_ID", ingress_vip = "OPERATOR_OCTAVIA_VIP", ingress_subnet_id = "OPERATOR_SUBNET_ID", ingress_member_port = 8012, api_readiness_port = 8013, api_target_active_requests = 8, api_target_ttft_ms = 500 }
# Kolla dynamic routing: lumen_api_dynamic_ingress_vip must match ingress_vip,
# and lumen_api_dynamic_ingress_port (default lumen_api_port) must match ingress_member_port.
# Use /v1/ready for Octavia/HAProxy health monitors; /v1/health is liveness only.
# Both HAProxy listeners use lumen_api_proxy_idle_timeout_seconds=3600 by default;
# set Octavia timeout_client_data and timeout_member_data to the same value in ms
# (3600000 by default), connect timeout 5 s, LEAST_CONNECTIONS, no persistence.
# Declare provider support for weight=0 drain + provisioning-status reads in Kolla.
# Drain keeps admin_state_up=true and polls member + pool ACTIVE before deletion;
# controller-owned member tags bind resource/generation/address/port/subnet.
#
# [[lumen.runtime_config.pools]]
# name = "text"
# role = "worker"
# workload_class = "online_text"
# cold_service_time_ms = 30000
# min_replicas = 1
# max_replicas = OPERATOR_TEXT_MAX
# max_surge = 1
# guest_profile_id = "text-service"
# backend = "nova"
# profile = { backend = "nova", flavor_id = "OPERATOR_TEXT_FLAVOR_ID", guest_image_id = "OPERATOR_WORKER_GLANCE_ID", guest_image_hash = "REPLACE_WITH_GLANCE_SHA256" }
# Copy the api pool's common cloud/image/network/budget fields; omit ingress.
#
# [[lumen.runtime_config.pools]]
# name = "media"
# role = "worker"
# workload_class = "online_media"
# cold_service_time_ms = 120000
# min_replicas = 1
# max_replicas = OPERATOR_MEDIA_MAX
# max_surge = 1
# guest_profile_id = "media-service"
# backend = "nova"
# profile = { backend = "nova", flavor_id = "OPERATOR_MEDIA_FLAVOR_ID", guest_image_id = "OPERATOR_WORKER_GLANCE_ID", guest_image_hash = "REPLACE_WITH_GLANCE_SHA256" }
# Copy the api pool's common cloud/image/network/budget fields; omit ingress.
#
# [[lumen.runtime_config.pools]]
# name = "batch"
# role = "worker"
# workload_class = "batch"
# cold_service_time_ms = 60000
# min_replicas = 0
# max_replicas = OPERATOR_BATCH_MAX
# max_surge = 1
# guest_profile_id = "batch-service"
# backend = "nova"
# profile = { backend = "nova", flavor_id = "OPERATOR_BATCH_FLAVOR_ID", guest_image_id = "OPERATOR_WORKER_GLANCE_ID", guest_image_hash = "REPLACE_WITH_GLANCE_SHA256" }
# Copy the api pool's common cloud/image/network/budget fields; omit ingress.

[lumen.runtime_config.project_quota_defaults]
max_active_children = 0
max_active_sandboxes = 0
max_sandbox_seconds = 0
max_credit_reservation = "0"

[lumen.runtime_config.renewal]
enabled = true
leaf_ttl_seconds = 3600
renew_interval_seconds = 1200
overlap_seconds = 120


# Installed plugin approval. Only exact distribution/name/version entries load; a
# missing or mismatched required plugin stops API/worker startup instead of falling
# back to an in-core implementation. Override with PLUGIN_CONFIG as a JSON object.
[lumen.plugin_config]
database = "mariadb"
memory = "default-memory"
tools = ["default-tools"]
skills = ["default-skills"]
mcp = ["remote-mcp", "afterglow-mcp"]
allowlist = [
  { kind = "database", name = "mariadb", distribution = "lumen-database-mariadb", version = "0.1.1" },
  { kind = "memory", name = "default-memory", distribution = "lumen-memory-default", version = "0.1.0" },
  { kind = "tools", name = "default-tools", distribution = "lumen-tools-default", version = "0.1.0" },
  { kind = "skills", name = "default-skills", distribution = "lumen-skills-default", version = "0.1.0" },
  { kind = "mcp", name = "remote-mcp", distribution = "lumen-mcp-default", version = "0.1.0" },
  { kind = "mcp", name = "afterglow-mcp", distribution = "lumen-mcp-default", version = "0.1.0" },
]
# Per-plugin operator settings, validated against each manifest's configuration schema.
# Secrets are server-side references, never literals.
[lumen.plugin_config.settings]

[chat]
chat_execution_protocol_version = 1
chat_default_model = ""
chat_compat_run_timeout_seconds = 300
chat_credit_per_usd = 1000.0
chat_default_monthly_quota = 100000.0
chat_stream_enabled = true
chat_api_hosts = "lumen.example"
# Claude Code gateway public base must be an origin plus this exact path.
claude_gateway_base_url = "https://lumen.example/v1/claude-gateway"
claude_gateway_model = "claude-opus-5-5"
# Public api_provider selector, independent of the provider display name and transport.
claude_gateway_provider = "anthropic"
# "none" is omitted (provider default) for models that cannot disable reasoning,
# including models whose disable support is unknown (no models.dev reasoning_options).
chat_reasoning_effort = "auto"
# Provider-native server-side compaction. Armed only on routes whose transport
# forwards `context_management` (Anthropic today) and whose context window is
# large enough to express the threshold above the provider's 50,000-token floor.
# Lumen's own durable compaction runs regardless of this switch.
chat_native_compaction_enabled = true
# The same feature on the stateless compatibility proxies (/v1/messages,
# /v1/responses, Claude gateway). A caller that sends its own
# context_management is never overridden; this only fills an absent field.
chat_native_compaction_passthrough_enabled = true
chat_run_event_retention_hours = 24
chat_checkpoint_retention_days = 7
# v2 durable protocol을 사용할 때만 encrypted PostgreSQL checkpointer URL을 설정한다.
chat_checkpointer_postgres_url = ""
chat_semantic_memory_enabled = false
chat_memory_pgvector_url = ""
chat_memory_embedding_model = ""
chat_memory_embedding_dimensions = 0
chat_memory_candidate_limit = 20
chat_memory_retrieval_token_budget = 1200
chat_memory_retention_days = 365
chat_asset_s3_endpoint = ""
chat_asset_s3_bucket = ""
chat_asset_s3_access_key = ""
chat_asset_s3_secret_key = ""
chat_asset_s3_region = "default"
# Required when asset storage is enabled: "none", "AES256", or "aws:kms". No implicit downgrade.
chat_asset_s3_server_side_encryption = ""
chat_asset_s3_kms_key_id = ""
chat_asset_signed_url_ttl_seconds = 300
chat_clamav_host = ""
chat_clamav_port = 3310
chat_sandbox_workspace_url = ""
chat_sandbox_url = ""
chat_sandbox_api_key = ""
chat_sandbox_image_digest = ""
chat_sandbox_policy_version = ""
chat_sandbox_egress_allowlist = []
chat_mcp_oauth_callback_url = ""
chat_mcp_public_url = ""

[mcp]
mcp_public_url = ""
mcp_control_plane_url = ""
lumen_mcp_service_token = ""
