# Lumen TOML Configuration File
# Generated by kolla-ansible Lumen role

[keystone]
keystone_auth_url = {{ lumen_keystone_auth_url | to_json }}
keystone_admin_username = {{ lumen_keystone_user | to_json }}
keystone_admin_password = {{ lumen_keystone_password | to_json }}
keystone_admin_project = {{ lumen_service_project_name | to_json }}
keystone_domain = {{ lumen_keystone_user_domain_name | to_json }}
keystone_region_name = {{ lumen_keystone_region_name | to_json }}
keystone_interface = {{ lumen_keystone_interface | to_json }}

[database]
database_url = {{ lumen_database_url | to_json }}
database_pool_size = 20
database_max_overflow = 10

[cache]
redis_url = {{ lumen_redis_url | to_json }}

[lumen]
lumen_encryption_key = {{ lumen_encryption_key | to_json }}
mcp_control_plane_url = {{ lumen_mcp_control_plane_url | to_json }}
public_api_base = {{ lumen_public_api_base | to_json }}
frontend_base_url = {{ lumen_frontend_base_url | to_json }}
worker_concurrency = {{ lumen_worker_concurrency }}
worker_heartbeat_seconds = {{ lumen_worker_heartbeat_seconds }}
worker_drain_seconds = {{ lumen_worker_drain_seconds }}
api_max_active_requests = {{ lumen_api_max_active_requests }}
api_max_sse_connections = {{ lumen_api_max_sse_connections }}
api_max_websocket_connections = {{ lumen_api_max_websocket_connections }}
api_max_body_bytes = {{ lumen_api_max_body_bytes }}
batch_enabled = {{ lumen_batch_enabled | bool | to_json }}
batch_dispatch_window = {{ lumen_batch_dispatch_window }}
batch_project_dispatch_window = {{ lumen_batch_project_dispatch_window }}
batch_native_max_items = {{ lumen_batch_native_max_items }}
batch_native_max_bytes = {{ lumen_batch_native_max_bytes }}
batch_jsonl_max_rows = {{ lumen_batch_jsonl_max_rows }}
batch_jsonl_max_bytes = {{ lumen_batch_jsonl_max_bytes }}
batch_jsonl_max_line_bytes = {{ lumen_batch_jsonl_max_line_bytes }}
batch_validation_chunk_rows = {{ lumen_batch_validation_chunk_rows }}
batch_validation_chunk_bytes = {{ lumen_batch_validation_chunk_bytes }}
batch_upload_slots = {{ lumen_batch_upload_slots }}
batch_result_ttl_days = {{ lumen_batch_result_ttl_days }}
batch_input_ttl_days = {{ lumen_batch_input_ttl_days }}
batch_cancel_grace_seconds = {{ lumen_batch_cancel_grace_seconds }}
{% if lumen_runtime_enabled | bool %}
# Typed RuntimeConfig supplied by the operator; validated at API/worker/controller startup.
runtime_config = {{ ((lumen_runtime_config | combine({'enabled': true, 'listen_host': lumen_controller_listen_address, 'listen_port': lumen_controller_listen_port})) | to_json) | to_json }}
{% endif %}

[chat]
chat_default_model = {{ lumen_chat_default_model | to_json }}
chat_compat_run_timeout_seconds = {{ lumen_chat_compat_run_timeout_seconds }}
claude_gateway_base_url = {{ lumen_claude_gateway_base_url | to_json }}
claude_gateway_model = {{ lumen_claude_gateway_model | to_json }}
claude_gateway_provider = {{ lumen_claude_gateway_provider | to_json }}
chat_checkpointer_postgres_url = {{ lumen_checkpointer_postgres_url | to_json }}
chat_memory_pgvector_url = {{ lumen_memory_pgvector_url | to_json }}
chat_asset_s3_endpoint = {{ lumen_s3_endpoint_url | to_json }}
chat_asset_s3_bucket = {{ lumen_s3_bucket | to_json }}
chat_asset_s3_access_key = {{ lumen_s3_access_key | to_json }}
chat_asset_s3_secret_key = {{ lumen_s3_secret_key | to_json }}
chat_asset_s3_region = {{ lumen_s3_region | to_json }}
chat_asset_s3_server_side_encryption = {{ lumen_s3_server_side_encryption | to_json }}
chat_asset_s3_kms_key_id = {{ lumen_s3_kms_key_id | to_json }}
chat_clamav_host = {{ lumen_clamav_host | to_json }}
chat_clamav_port = {{ lumen_clamav_port }}
chat_sandbox_api_key = {{ lumen_sandbox_api_key | to_json }}
chat_api_hosts = {{ lumen_chat_api_hosts | to_json }}
