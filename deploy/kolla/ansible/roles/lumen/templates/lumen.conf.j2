# Lumen TOML Configuration File
# Generated by kolla-ansible Lumen role

[keystone]
keystone_auth_url = "{{ lumen_keystone_auth_url }}"
keystone_admin_username = "{{ lumen_keystone_user }}"
keystone_admin_password = "{{ lumen_keystone_password }}"
keystone_admin_project = "{{ lumen_service_project_name }}"
keystone_domain = "{{ lumen_keystone_user_domain_name }}"
keystone_region_name = "{{ lumen_keystone_region_name }}"
keystone_interface = "{{ lumen_keystone_interface }}"

[database]
database_url = "{{ lumen_database_url }}"
database_pool_size = 20
database_max_overflow = 10

[cache]
redis_url = "{{ lumen_redis_url }}"

[lumen]
lumen_encryption_key = "{{ lumen_encryption_key }}"
mcp_control_plane_url = "{{ lumen_mcp_control_plane_url }}"
public_api_base = "{{ lumen_public_api_base }}"
frontend_base_url = "{{ lumen_frontend_base_url }}"
worker_concurrency = {{ lumen_worker_concurrency }}
worker_heartbeat_seconds = {{ lumen_worker_heartbeat_seconds }}
worker_drain_seconds = {{ lumen_worker_drain_seconds }}
{% if lumen_runtime_enabled | bool %}
# Typed RuntimeConfig supplied by the operator; validated at API/worker/controller startup.
runtime_config = {{ ((lumen_runtime_config | combine({'enabled': true, 'listen_host': lumen_controller_listen_address, 'listen_port': lumen_controller_listen_port})) | to_json) | to_json }}
{% endif %}

[chat]
chat_default_model = "{{ lumen_chat_default_model }}"
chat_compat_run_timeout_seconds = {{ lumen_chat_compat_run_timeout_seconds }}
claude_gateway_base_url = "{{ lumen_claude_gateway_base_url }}"
claude_gateway_model = "{{ lumen_claude_gateway_model }}"
claude_gateway_provider = "{{ lumen_claude_gateway_provider }}"
chat_checkpointer_postgres_url = "{{ lumen_checkpointer_postgres_url }}"
chat_memory_pgvector_url = "{{ lumen_memory_pgvector_url }}"
chat_asset_s3_endpoint = "{{ lumen_s3_endpoint_url }}"
chat_asset_s3_bucket = "{{ lumen_s3_bucket }}"
chat_asset_s3_access_key = "{{ lumen_s3_access_key }}"
chat_asset_s3_secret_key = "{{ lumen_s3_secret_key }}"
chat_asset_s3_region = "{{ lumen_s3_region }}"
chat_asset_s3_server_side_encryption = "{{ lumen_s3_server_side_encryption }}"
chat_asset_s3_kms_key_id = "{{ lumen_s3_kms_key_id }}"
chat_sandbox_api_key = "{{ lumen_sandbox_api_key }}"
chat_api_hosts = "{{ lumen_chat_api_hosts }}"
